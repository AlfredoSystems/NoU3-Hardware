{
    "layout": {
        "type": "grid",
        "rows": 3,
        "cols": 3,
        "hspace": "2mm",
        "vspace": "2mm",
        "vbackbone": "3mm",
        "vbonecut": false
    },
    "source": {
        "tolerance": "30mm",
        "stack": "4layer"
    },
    "tabs": {
        "type": "fixed",
        "hcount": 2,
        "vcount": 0,
        "hwidth": "3mm",
        "fillet": "1mm"
    },
    "cuts": {
        "type": "vcuts",
        "clearance": "0.4mm",
        "linewidth": "0.4mm",
        "layer": "Edge.Cuts"
    },
    "framing": {
        "type": "railslr",
        "width": "5mm",
        "hspace": "2mm"
    },
    "post": {
        "millradius": "0.99mm"
    }
}